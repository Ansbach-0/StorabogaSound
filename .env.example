# Discord bot
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_oauth2_client_id_here
DISCORD_CLIENT_SECRET=your_oauth2_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:2497/auth/callback

# Web server
WEB_HOST=0.0.0.0
WEB_PORT=2497
SECRET_KEY=generate_a_random_secret_key_here

# Database
DB_PATH=storaboga.db

# FFmpeg (system binary, not pip)
FFMPEG_PATH=ffmpeg

# yt-dlp proxy (optional — set if YouTube blocks your server's IP)
# Format: http://<token>@<host>:<port>
# YTDLP_PROXY=http://yourproxytoken@your.proxy.host:47171

# yt-dlp cookies (optional — set if YouTube shows 'Sign in to confirm you're not a bot')
# Export cookies from your browser using an extension like 'Get cookies.txt' (Chrome/Firefox)
# Then upload cookies.txt to the server and set the path here
# YTDLP_COOKIEFILE=/path/to/cookies.txt

# Bot owner (optional — auto-detected from Discord application info)
# BOT_OWNER_ID=123456789012345678

